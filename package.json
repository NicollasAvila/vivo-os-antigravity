{
  "name": "vivo-os-project",
  "version": "1.0.0",
  "description": "Integration and development workspace for Vivo OS (Mogno AI)",
  "type": "module",
  "main": "src/client.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "status": "node src/status.js",
    "seiva": "node scripts/seiva.js",
    "cargos:status": "cd apps/cargos-e-salarios && node ../../scripts/seiva.js status",
    "cargos:pull": "cd apps/cargos-e-salarios && node ../../scripts/seiva.js pull",
    "cargos:push": "cd apps/cargos-e-salarios && node ../../scripts/seiva.js push",
    "cargos:build": "cd apps/cargos-e-salarios && node ../../scripts/seiva.js build",
    "mcp": "node ./node_modules/mogno-mcp/client.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mogno-mcp": "^0.6.0"
  }
}

